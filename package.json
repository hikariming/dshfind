{
  "name": "dshfind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "pnpm --filter @dshfind/web run dev",
    "build": "pnpm --filter @dshfind/web run build",
    "lint": "eslint",
    "test": "node --test scripts/lib/*.test.mjs",
    "test:e2e:d1": "node --test scripts/e2e/d1-read-budgets.mjs",
    "test:e2e:reads": "node scripts/e2e/public-read-http.mjs",
    "ci:frontend": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "gen:plugins": "node --env-file-if-exists=.env.local scripts/gen-plugins-real.mjs",
    "gen:data": "pnpm run gen:plugins && pnpm run gen:docs && pnpm run gen:lessons",
    "discover:npm": "node scripts/discover-npm.mjs",
    "sync:db": "node --env-file-if-exists=.env.local scripts/sync-plugins-db.mjs",
    "probe:install": "node --env-file-if-exists=.env.local scripts/probe-install.mjs",
    "entry:check": "node --env-file-if-exists=.env.local scripts/entry-check.mjs",
    "images:init": "node --env-file-if-exists=.env.local scripts/init-plugin-images-schema.mjs",
    "images:extract": "node --env-file-if-exists=.env.local scripts/extract-plugin-images.mjs",
    "backfill:is-plugin": "node --env-file-if-exists=.env.local scripts/backfill-is-plugin.mjs",
    "gen:docs": "node --env-file-if-exists=.env.local scripts/gen-docs-manifest.mjs",
    "gen:lessons": "node scripts/gen-lessons-manifest.mjs",
    "probe:badge": "node --env-file-if-exists=.env.local scripts/probe-badge.mjs",
    "probe:downloads": "node --env-file-if-exists=.env.local scripts/probe-downloads.mjs",
    "refresh": "node --env-file-if-exists=.env.local scripts/refresh-site.mjs",
    "readmes:fetch": "node --env-file-if-exists=.env.local scripts/fetch-readmes.mjs",
    "typecheck": "pnpm --filter @dshfind/web run check"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.30.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.9",
    "react-dom": "19.2.9",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1116.0",
    "@eslint/js": "^9",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "globals": "^16",
    "miniflare": "5.20260811.1-alpha",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "semver": "^7.8.5",
    "sharp": "^0.35.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "typescript-eslint": "^8",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "wrangler": "^4.144.0"
  },
  "packageManager": "pnpm@11.9.0"
}
