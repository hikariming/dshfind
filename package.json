{
  "name": "dshfind",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "cf:build": "opennextjs-cloudflare build",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "node --test scripts/lib/*.test.mjs",
    "ci:frontend": "pnpm typecheck && pnpm lint && pnpm test && pnpm build",
    "ci:backend": "cd server && go test -race ./... && go vet ./... && CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags='-s -w' -o /tmp/dshfind-api ./cmd/api && cd .. && docker build --file server/Dockerfile --tag dshfind-api-ci .",
    "gen:plugins": "node --env-file-if-exists=.env.local scripts/gen-plugins-real.mjs",
    "gen:ranking": "node scripts/gen-ranking-real.mjs",
    "gen:data": "pnpm run gen:plugins && pnpm run gen:ranking && pnpm run gen:docs && pnpm run gen:lessons",
    "sync:db": "node --env-file-if-exists=.env.local scripts/sync-plugins-db.mjs",
    "probe:install": "node --env-file-if-exists=.env.local scripts/probe-install.mjs",
    "backfill:is-plugin": "node --env-file-if-exists=.env.local scripts/backfill-is-plugin.mjs",
    "gen:docs": "node --env-file-if-exists=.env.local scripts/gen-docs-manifest.mjs",
    "gen:lessons": "node scripts/gen-lessons-manifest.mjs"
  },
  "dependencies": {
    "@libsql/client": "^0.17.4",
    "@mdx-js/loader": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@next/mdx": "^16.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@types/mdx": "^2.0.14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jose": "^6.2.8",
    "lucide-react": "^1.30.0",
    "next": "16.3.0",
    "next-intl": "^4.13.5",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.16.2",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.2",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.0",
    "semver": "^7.8.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.123.0"
  },
  "packageManager": "pnpm@11.9.0"
}
