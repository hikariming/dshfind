---
/**
 * facet 横向导航（分类↔分类、语言↔语言、标签↔标签），与老站 PluginFacetNav 一致：
 * 把 hub 页之间连成网，爬虫从任意 hub 进来都能横向走遍其余 hub。
 */
import type { HubFacet } from "@/lib/plugin-hubs";
import type { Locale } from "~/i18n";

interface Props {
  locale: Locale;
  title: string;
  /** 链接前缀，如 "/plugins/c" */
  base: string;
  facets: HubFacet[];
  activeSlug?: string;
  /** slug → 展示名；不传则用 facet.name */
  labels?: Record<string, string>;
  /** 展示名前缀，标签页用 "#" */
  prefix?: string;
}

const { locale, title, base, facets, activeSlug, labels, prefix = "" } = Astro.props;
---

{
  facets.length > 0 && (
    <section class="mt-10 border-t border-border/60 pt-6">
      <h2 class="text-sm font-semibold">{title}</h2>
      <div class="mt-3 flex flex-wrap gap-1.5">
        {facets.map((f) => (
          <a href={`/${locale}${base}/${f.slug}`}>
            <span
              class:list={[
                "inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border px-2 py-0.5 text-[11px] font-normal whitespace-nowrap transition-all hover:border-brand-500/60",
                f.slug === activeSlug
                  ? "border-transparent bg-secondary text-secondary-foreground"
                  : "border-border text-foreground",
              ]}
            >
              {prefix}
              {labels?.[f.slug] ?? f.name}
              <span class="ml-1 tabular-nums opacity-60">{f.count}</span>
            </span>
          </a>
        ))}
      </div>
    </section>
  )
}
