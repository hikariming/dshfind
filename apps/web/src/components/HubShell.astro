---
/**
 * 插件聚合页（分类/标签/语言/全量索引）共用外壳，对齐老站 PluginHubShell + PluginHubList：
 * 面包屑 + 标题 + 计数行 + 插件列表 + 附加区块（slot）。
 *
 * 列表每条都是真 <a href>、全量出现在静态 HTML 里——hub 页存在的意义就是让爬虫顺链接走到详情页；
 * 卡片刻意比插件超市的轻：一页 200 条，重卡片会把 HTML 撑到几百 KB。
 */
import type { HubPlugin } from "@/lib/plugin-hubs";
import { localizePluginDescription } from "@/lib/plugin-i18n";
import type { Crumb } from "@/lib/structured-data";
import Breadcrumb from "~/components/Breadcrumb.astro";
import PluginCardList from "~/components/PluginCardList.astro";
import type { Locale } from "~/i18n";

interface Props {
  locale: Locale;
  crumbs: Crumb[];
  heading: string;
  countLine: string;
  plugins: HubPlugin[];
}

const { locale, crumbs, heading, countLine, plugins } = Astro.props;
// 预渲染页：构建期按语言取译文
const cards = plugins.map((p) => ({ ...p, description: localizePluginDescription(p.fullName, locale, p.description) }));
---

<div class="mx-auto w-full max-w-5xl px-4 py-10 sm:px-6">
  <Breadcrumb locale={locale} crumbs={crumbs} />
  <h1 class="mt-3 text-2xl font-bold sm:text-3xl">{heading}</h1>
  <p class="mt-1.5 text-sm text-muted-foreground tabular-nums">{countLine}</p>
  <PluginCardList plugins={cards} locale={locale} />
  <slot />
</div>
