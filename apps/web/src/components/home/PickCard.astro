---
/** 首页三条 rail 共用的卡片（与老站 sections/pick-card.tsx 一致）。 */
import type { HomePick } from "@/lib/types";
import ScoreBadge from "~/components/ScoreBadge.astro";
import { translator, type Locale } from "~/i18n";

interface Props {
  pick: HomePick;
  /** 构建期按当前语言解析好的一句话短评；空串则省掉这一段 */
  blurb: string;
  locale: Locale;
  /** 同一区块内依次淡入的错开毫秒数 */
  delay: number;
  /** 编辑推荐「换一批」用：卡片所属批次；非首批默认隐藏 */
  batch?: number;
}

const { pick, blurb, locale, delay, batch } = Astro.props;
const t = translator(locale);
const BADGE = "inline-flex h-5 w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-4xl border border-transparent px-2 py-0.5 text-xs font-medium whitespace-nowrap";
const hasMarks = pick.isOfficial || pick.isFeatured || pick.isInsider || pick.starGrowth != null || pick.firstSeenAt != null;
---

<div data-reveal="" data-batch={batch} hidden={batch != null && batch > 0} style={delay ? `transition-delay: ${delay}ms` : undefined} class="flex">
  <a
    href={`/${locale}/plugins/${pick.fullName}`}
    class="group flex w-full flex-col rounded-xl border border-border/60 bg-card p-4 transition-colors hover:border-brand-500/50 hover:bg-muted/40"
  >
    <div class="flex items-start justify-between gap-2">
      <span class="flex items-center gap-1.5 font-mono text-sm font-semibold break-all group-hover:text-brand-600 dark:group-hover:text-brand-300">
        {pick.name}
        <ScoreBadge score={pick.score} locale={locale} />
      </span>
      <span class="flex shrink-0 items-center gap-1 text-xs text-muted-foreground tabular-nums">
        <svg class="size-3 fill-amber-400 text-amber-400" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" /></svg>
        {pick.stars.toLocaleString("en-US")}
      </span>
    </div>
    <span class="text-xs text-muted-foreground">@{pick.owner}</span>
    {
      hasMarks && (
        <div class="mt-2 flex flex-wrap gap-1.5">
          {pick.isOfficial && <span class:list={[BADGE, "bg-sky-600 text-white dark:bg-sky-500"]}>🏛 {t("Plugins.official")}</span>}
          {pick.isFeatured && <span class:list={[BADGE, "bg-gradient-brand text-white"]}>✨ {t("Plugins.featured")}</span>}
          {pick.isInsider && <span class:list={[BADGE, "bg-secondary text-secondary-foreground"]}>{t("Plugins.insider")}</span>}
          {pick.starGrowth != null && (
            <span class:list={[BADGE, "bg-secondary tabular-nums text-emerald-700 dark:text-emerald-300"]}>
              <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M16 7h6v6" /><path d="m22 7-8.5 8.5-5-5L2 17" /></svg>+
              {pick.starGrowth.toLocaleString("en-US")}
            </span>
          )}
          {pick.firstSeenAt != null && (
            <span class:list={[BADGE, "bg-secondary tabular-nums text-secondary-foreground"]}>
              {t("Home.newBadge")} · {pick.firstSeenAt.slice(5)}
            </span>
          )}
        </div>
      )
    }
    {blurb && <p class="mt-2 line-clamp-2 text-xs leading-relaxed text-muted-foreground">{blurb}</p>}
  </a>
</div>
