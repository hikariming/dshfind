---
/** 页脚，结构与链接对齐老站 SiteFooter：品牌 + 产品 / 资源 / 社区 / 友情链接四组 + 版权条。 */
import { translator, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
// 站内链接补语言前缀；外链原样
const href = (h: string) => (h.startsWith("http") ? h : `/${locale}${h}`);
const groups = [
  {
    title: t("Footer.product"),
    links: [
      { label: t("Footer.learn"), href: "/learn" },
      { label: t("Footer.plugins"), href: "/plugins" },
      // 全站每一页都能一跳到分类索引，索引页再散出全部 hub——插件详情页拿到站内权重的主通路
      { label: t("Footer.browse"), href: "/plugins/browse" },
    ],
  },
  {
    title: t("Footer.resources"),
    links: [
      { label: t("Footer.docs"), href: "/docs" },
      { label: t("Footer.cordis"), href: "/learn/cordis" },
      { label: "DSH 入门指南", href: "/learn#dsh-intro" },
      { label: t("Footer.glossary"), href: "/learn/cordis#glossary" },
    ],
  },
  {
    title: t("Footer.community"),
    links: [
      { label: t("Footer.github"), href: "https://github.com/hikariming/dshfind" },
      { label: t("Footer.login"), href: "/login" },
    ],
  },
  {
    title: t("Footer.friendLinks"),
    links: [
      { label: "DSH Hub", href: "https://hub.omdsh.dev" },
      { label: "DSH Desktop", href: "https://dshdesktop.cn" },
      { label: "妙智云 GEO", href: "https://www.mzyai.com" },
      { label: "DSH-Registry", href: "https://dshregistry.xyz" },
    ],
  },
];
---

<footer class="border-t border-border/60 bg-background/60">
  <div class="mx-auto grid w-full max-w-6xl gap-10 px-4 py-12 sm:px-6 md:grid-cols-[1.5fr_1fr_1fr_1fr_1fr]">
    <div>
      <div class="flex items-center gap-2">
        <span class="bg-gradient-brand flex size-7 items-center justify-center rounded-lg text-sm font-bold text-white">d</span>
        <span class="text-base font-bold tracking-tight">dsh<span class="text-brand-500 dark:text-brand-300">find</span></span>
      </div>
      <p class="mt-3 max-w-xs text-sm text-muted-foreground">{t("Footer.tagline")}</p>
    </div>
    {
      groups.map((group) => (
        <div>
          <h3 class="text-sm font-semibold">{group.title}</h3>
          <ul class="mt-3 space-y-2">
            {group.links.map((link) => (
              <li>
                <a href={href(link.href)} class="text-sm text-muted-foreground transition-colors hover:text-foreground">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
  <div class="border-t border-border/60">
    <div class="mx-auto flex w-full max-w-6xl flex-col items-center justify-between gap-2 px-4 py-4 text-xs text-muted-foreground sm:flex-row sm:px-6">
      <p>© 2026 dshfind.com · dsh-external</p>
      <p>{t("Footer.madeWith")}</p>
    </div>
  </div>
</footer>
