---
/**
 * 全站唯一的 <head> SEO 出口。字段口径对齐老站 Next metadata（scripts/rewrite/seo-parity.mjs 校验）：
 * title 模板「%s · dshfind」、canonical 指向当前语言、四语言 hreflang + x-default。
 */
import { jsonLdSafe } from "@/lib/json-ld";
import { OG_HEIGHT, OG_WIDTH } from "@/lib/og";
import { languageAlternates, localeUrl, ogLocales } from "@/lib/site";
import { translator, type Locale } from "~/i18n";

export interface Props {
  locale: Locale;
  /** 语言前缀之后的路径，以 / 开头；首页传 "" */
  path: string;
  /** 页面标题（不含站点后缀）；缺省用站点标题 */
  title?: string;
  description?: string;
  ogType?: "website" | "article";
  /** true = "noindex, follow"（缺译文回落页）；字符串原样输出（风险插件用 "noindex"，与老站一致） */
  noindex?: boolean | string;
  /** 分享大图（1200×630）；给了就换成 summary_large_image 卡型 */
  ogImage?: { url: string; alt: string };
  jsonLd?: unknown[];
  /** 不输出 canonical / hreflang / og:url（404 等不该被当作某个 URL 正本的页面） */
  bare?: boolean;
  /**
   * 指定 canonical（绝对 URL）且不输出 hreflang：论坛帖子只有一种写作语言，
   * 四个语言前缀下是同一篇正文，canonical 一律指回写作语言那一份（与老站一致）
   */
  canonical?: string;
}

const {
  locale,
  path,
  title,
  description,
  ogType = "website",
  noindex = false,
  ogImage,
  jsonLd = [],
  bare = false,
  canonical,
} = Astro.props;
const robots = noindex === true ? "noindex, follow" : noindex || null;
const t = translator(locale);
const siteTitle = t("Meta.siteTitle");
const fullTitle = title ? `${title} · dshfind` : siteTitle;
const desc = description ?? t("Meta.siteDescription");
const alternates = languageAlternates(path);
---

<title>{fullTitle}</title>
<meta name="description" content={desc} />
<meta name="application-name" content="dshfind" />
<meta
  name="keywords"
  content="DeepSeek Harness plugin,dsh-plugin,DSH plugin,DeepSeek Harness,DSH,Cordis"
/>
{robots && <meta name="robots" content={robots} />}
{!bare && <link rel="canonical" href={canonical ?? localeUrl(locale, path)} />}
{!bare && !canonical && Object.entries(alternates).map(([lang, href]) => <link rel="alternate" hreflang={lang} href={href} />)}
<meta property="og:title" content={title ?? siteTitle} />
<meta property="og:description" content={desc} />
<meta property="og:type" content={ogType} />
{!bare && <meta property="og:url" content={canonical ?? localeUrl(locale, path)} />}
<meta property="og:site_name" content="dshfind" />
<meta property="og:locale" content={ogLocales[locale]} />
{
  ogImage && (
    <>
      <meta property="og:image" content={ogImage.url} />
      <meta property="og:image:width" content={String(OG_WIDTH)} />
      <meta property="og:image:height" content={String(OG_HEIGHT)} />
      <meta property="og:image:alt" content={ogImage.alt} />
    </>
  )
}
<!-- 有大图必须同时改卡型：X 默认 summary 会把图压成缩略角标 -->
<meta name="twitter:card" content={ogImage ? "summary_large_image" : "summary"} />
<meta name="twitter:title" content={title ?? siteTitle} />
<meta name="twitter:description" content={desc} />
{ogImage && <meta name="twitter:image" content={ogImage.url} />}
{jsonLd.map((data) => <script type="application/ld+json" set:html={jsonLdSafe(data)} />)}
