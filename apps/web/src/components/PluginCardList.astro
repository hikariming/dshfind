---
/**
 * 轻量插件卡片列表（与老站 PluginHubList 一致）：hub 页、详情页「相关插件」、文档页「相关插件」共用。
 * 描述由调用方按语言解析好再传入——本组件不碰 plugin-i18n，按需渲染的页面也能用。
 */
import ScoreBadge from "~/components/ScoreBadge.astro";
import type { Locale } from "~/i18n";

export interface CardPlugin {
  fullName: string;
  name: string;
  owner: string;
  description: string;
  stars: number;
  score: number | null;
  language: string;
}

interface Props {
  plugins: CardPlugin[];
  locale: Locale;
}

const { plugins, locale } = Astro.props;
---

<ul class="mt-6 grid gap-3 sm:grid-cols-2">
  {
    plugins.map((p) => (
      <li>
        <a
          href={`/${locale}/plugins/${p.fullName}`}
          class="flex h-full flex-col rounded-xl border border-border/60 bg-card p-4 transition-colors hover:border-brand-500/60"
        >
          <div class="flex items-start justify-between gap-2">
            <span class="min-w-0 font-mono text-sm font-semibold break-all">{p.name}</span>
            <ScoreBadge score={p.score} locale={locale} />
          </div>
          <span class="mt-0.5 truncate text-xs text-muted-foreground">@{p.owner}</span>
          {p.description && <span class="mt-2 line-clamp-2 text-sm leading-snug text-muted-foreground">{p.description}</span>}
          <span class="mt-3 flex items-center gap-3 border-t border-border/60 pt-2.5 text-xs text-muted-foreground">
            <span class="inline-flex items-center gap-1 tabular-nums">
              <svg class="size-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="M11.525 2.295a.53.53 0 0 1 .95 0l2.31 4.679a2.123 2.123 0 0 0 1.595 1.16l5.166.756a.53.53 0 0 1 .294.904l-3.736 3.638a2.123 2.123 0 0 0-.611 1.878l.882 5.14a.53.53 0 0 1-.771.56l-4.618-2.428a2.122 2.122 0 0 0-1.973 0L6.396 21.01a.53.53 0 0 1-.77-.56l.881-5.139a2.122 2.122 0 0 0-.611-1.879L2.16 9.795a.53.53 0 0 1 .294-.906l5.165-.755a2.122 2.122 0 0 0 1.597-1.16z" />
              </svg>
              {p.stars.toLocaleString("en-US")}
            </span>
            {p.language && <span>{p.language}</span>}
          </span>
        </a>
      </li>
    ))
  }
</ul>
