---
import { Font } from "astro:assets";

import "~/styles/global.css";
import Seo from "~/components/Seo.astro";
import SiteFooter from "~/components/SiteFooter.astro";
import SiteHeader from "~/components/SiteHeader.astro";
import SponsorBanner from "~/components/SponsorBanner.astro";
import { API_BASE } from "~/config";

type Props = import("~/components/Seo.astro").Props & {
  /**
   * 是否加载 AdSense（自动广告）。默认关：只给有原创正文的页面开。
   * 插件详情（主体是转载的 GitHub README）、文档（上游镜像/翻译）、列表/标签/分页、
   * 登录/搜索/发帖/404 这类页面挂广告会被判「复制内容」「低价值内容」政策违规。
   */
  ads?: boolean;
};

const { ads = false, ...props } = Astro.props;
---

<!doctype html>
<html lang={props.locale} class="dark h-full antialiased">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <!--
      主题防闪烁：沿用 next-themes 的 localStorage 键与默认值（dark + 跟随系统），
      老站用户切过来主题不丢。必须同步执行，放在任何样式生效之前。
    -->
    <script is:inline>
      (() => {
        try {
          const t = localStorage.getItem("theme") || "dark";
          const dark = t === "dark" || (t === "system" && matchMedia("(prefers-color-scheme: dark)").matches);
          document.documentElement.classList.toggle("dark", dark);
          document.documentElement.style.colorScheme = dark ? "dark" : "light";
        } catch {}
      })();
    </script>
    <Font cssVariable="--font-geist-sans" preload />
    <Font cssVariable="--font-geist-mono" />
    <Seo {...props} />
    <link rel="icon" href="/favicon.ico" sizes="32x32" type="image/x-icon" />
    <link rel="icon" href="/icon.png" sizes="512x512" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-icon.png" sizes="180x180" type="image/png" />
    <!-- 搜索框直连 API 时提前握手，摊平首次搜索的 TLS 延迟（老站同款） -->
    <link rel="preconnect" href={API_BASE} />
    <!--
      Google AdSense：站点验证 + 自动广告入口，只在 ads 页面加载（首页必须开，站点验证靠它）。
      ca-pub 与 public/ads.txt 里的发布商 ID 必须一致
    -->
    {
      ads && (
        <script
          is:inline
          async
          src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-4723780114162477"
          crossorigin="anonymous"
        />
      )
    }
  </head>
  <body class="flex min-h-full flex-col">
    <SponsorBanner locale={props.locale} />
    <SiteHeader locale={props.locale} />
    <main class="flex-1">
      <slot />
    </main>
    <SiteFooter locale={props.locale} />
    <!-- Cloudflare Web Analytics（与老站同一 token）。defer：不与首屏抢带宽 -->
    <script
      is:inline
      defer
      src="https://static.cloudflareinsights.com/beacon.min.js"
      data-cf-beacon='{"token": "73bd788bb2f74183b99a31d0c4d67156"}'></script>
  </body>
</html>
