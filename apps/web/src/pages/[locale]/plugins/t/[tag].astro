---
/**
 * 标签聚合页：老站按需渲染（revalidate=0），这里全部预渲染（插件数 ≥ MIN_TAG_PLUGINS 的标签 × 4 语言），
 * 请求直接由静态资源返回，不再占 Worker CPU。
 */
import type { GetStaticPaths } from "astro";

import { HUB_LIST_LIMIT, listTags, tagHub } from "@/lib/plugin-hubs";
import { breadcrumbJsonLd, itemListJsonLd } from "@/lib/structured-data";
import FacetNav from "~/components/FacetNav.astro";
import HubShell from "~/components/HubShell.astro";
import Base from "~/layouts/Base.astro";
import { locales, translator, type Locale } from "~/i18n";

/** facet 导航里露出的标签数——全列出来会让每页多几 KB 且没人扫得完 */
const NAV_TAGS = 60;

export const getStaticPaths = (() =>
  locales.flatMap((locale) => listTags().map((tag) => ({ params: { locale, tag: tag.slug } })))) satisfies GetStaticPaths;

const locale = Astro.params.locale as Locale;
const tag = Astro.params.tag!;
const hub = tagHub(tag)!;
const t = translator(locale);
const heading = t("Plugins.hub.tagHeading", { name: hub.name });
const crumbs = [
  { name: "dshfind", path: "" },
  { name: t("Plugins.title"), path: "/plugins" },
  { name: `#${hub.name}`, path: `/plugins/t/${tag}` },
];
// 当前标签不在前 NAV_TAGS 时补进导航，否则用户在本页看不到自己所处的位置
const navTags = listTags().slice(0, NAV_TAGS);
if (!navTags.some((x) => x.slug === tag)) {
  const self = listTags().find((x) => x.slug === tag);
  if (self) navTags.unshift(self);
}
---

<Base
  locale={locale}
  path={`/plugins/t/${tag}`}
  title={t("Meta.hubTagTitle", { name: hub.name, count: hub.total })}
  description={t("Meta.hubTagDescription", { name: hub.name, count: hub.total })}
  jsonLd={[breadcrumbJsonLd(locale, crumbs), itemListJsonLd(locale, heading, hub.plugins)]}
>
  <HubShell
    locale={locale}
    crumbs={crumbs}
    heading={heading}
    countLine={hub.total > HUB_LIST_LIMIT
      ? t("Plugins.hub.showingTop", { shown: hub.plugins.length, total: hub.total })
      : t("Plugins.hub.showingAll", { total: hub.total })}
    plugins={hub.plugins}
  >
    {
      hub.total > HUB_LIST_LIMIT && (
        <p class="mt-6 text-sm">
          <a href={`/${locale}/plugins/all/1`} class="underline underline-offset-4 hover:text-brand-500">
            {t("Plugins.hub.viewAllIndex")} →
          </a>
        </p>
      )
    }
    <FacetNav locale={locale} title={t("Plugins.hub.browseTags")} base="/plugins/t" facets={navTags} activeSlug={tag} prefix="#" />
  </HubShell>
</Base>
