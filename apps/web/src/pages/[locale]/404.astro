---
/** 各语言的 404 页，供按需路由（详情页等）找不到内容时按 URL 语言取用（~/detail/data.ts 的 notFoundResponse）。 */
import type { GetStaticPaths } from "astro";

import NotFound from "~/components/NotFound.astro";
import { locales, type Locale } from "~/i18n";

export const getStaticPaths = (() => locales.map((locale) => ({ params: { locale } }))) satisfies GetStaticPaths;
---

<NotFound locale={Astro.params.locale as Locale} />
