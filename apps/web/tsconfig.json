{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/components/quiz": ["./src/components/quiz.ts"],
      "@/i18n/navigation": ["./src/compat/navigation.tsx"],
      "next-intl": ["./src/compat/next-intl.tsx"],
      "next/navigation": ["./src/compat/navigation.tsx"],
      "@/*": ["../../src/*"],
      "~/*": ["./src/*"]
    }
  }
}
