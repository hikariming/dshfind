{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": ["dist"],
  "compilerOptions": {
    "jsx": "react-jsx",
    "jsxImportSource": "preact",
    "paths": {
      "@/components/quiz": ["./src/components/quiz.ts"],
      "@/*": ["../../src/*"],
      "~/*": ["./src/*"]
    }
  }
}
