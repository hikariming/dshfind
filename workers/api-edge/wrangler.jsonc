{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "dshfind-api-edge",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-01",

  // 产物由 scripts/gen-api-artifacts.mjs 生成（refresh-site 流水线的一环），
  // 随 wrangler deploy 一起发布。路由只送 /v1/plugins* 进来，产物路径不会
  // 与之重叠，故不可能被外部直接拉取 NDJSON。
  "assets": {
    "directory": "./assets",
    "binding": "ASSETS"
  },

  // 详情端点的 i18n 与 star 历史必须实时查库（产物里放不下，也没必要）。
  // 与主站 wrangler.jsonc 指向同一个库；这里只读。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "dshfind",
      "database_id": "47f4c8d2-a9d7-41c3-b142-f8693b20a89d"
    }
  ],

  // 接管两条读路径：目录列表与桌面端市场契约。详情页 /v1/plugins/{owner}/{repo}
  // 与 /discussion 也会匹配进第一条，worker 对非列表路径 fetch(request) 原样透传
  // Railway 源站——同 zone 子请求不重入 Worker 路由。
  // 产物本身放在 assets 根（catalog-*.ndjson / market-*.json），不在这两个前缀下，
  // 外部拉不到。挂路由前提：api.dshfind.com 已橙云代理（P0）。
  "routes": [
    {
      "pattern": "api.dshfind.com/v1/plugins*",
      "zone_name": "dshfind.com"
    },
    {
      "pattern": "api.dshfind.com/market/*",
      "zone_name": "dshfind.com"
    },
    // 末尾的 * 不能省：CF 路由匹配的是整个 URL，没有它就匹配不上带 query 的请求。
    {
      "pattern": "api.dshfind.com/v1/suggest*",
      "zone_name": "dshfind.com"
    },
    {
      "pattern": "api.dshfind.com/v1/catalog*",
      "zone_name": "dshfind.com"
    },
    // 同时覆盖 /graphql 与 /graphql/schema
    {
      "pattern": "api.dshfind.com/graphql*",
      "zone_name": "dshfind.com"
    },
    // S3：论坛 + 鉴权。/v1/plugins* 已覆盖 discussion/comments/vote 子路径。
    {
      "pattern": "api.dshfind.com/v1/forum*",
      "zone_name": "dshfind.com"
    },
    {
      "pattern": "api.dshfind.com/v1/me/*",
      "zone_name": "dshfind.com"
    },
    {
      "pattern": "api.dshfind.com/auth/*",
      "zone_name": "dshfind.com"
    }
  ],

  // 论坛写与登录的限流计数器（ratelimit.mjs）：单实例 DO，串行执行天然全局
  // 一致。只有写路径与 auth 会碰它（每天几十次调用），读路径不经过限流。
  "durable_objects": {
    "bindings": [
      {
        "name": "RATE_LIMITER",
        "class_name": "RateLimiter"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RateLimiter"]
    }
  ],

  // 非机密配置。机密（AUTH_SECRET / GITHUB_CLIENT_SECRET）用
  // wrangler secret put 配，见 d1-migration-plan §S3。
  "vars": {
    "WEB_URL": "https://dshfind.com",
    "API_PUBLIC_URL": "https://api.dshfind.com",
    "AUTH_COOKIE_DOMAIN": "dshfind.com",
    // OAuth App 的公开标识（会出现在浏览器跳转 URL 里，不是机密）
    "GITHUB_CLIENT_ID": "Ov23liYjg53iiY627GBf"
  },

  "observability": {
    "enabled": true
  }
}
